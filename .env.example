# ==============================================================================
# DataMind v2 Environment Configuration Template
# Copy to .env in backend/ or root for local development. Never commit .env to git.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:3000"]

# Database (Zero-Config Local Docker Postgres on 5432)
# Async URL for FastAPI + AsyncPG:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
# Sync URL for Alembic migrations:
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Redis Broker / Cache
REDIS_URL=redis://localhost:6379/0

# Security & Cryptography (Generate high-entropy strings in production)
JWT_SECRET=supersecret-at-least-32-chars-long-development-jwt-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_SECRET=supersecret-at-least-32-chars-long-session-encryption-key

# LLM & Local Ollama Config
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120

# Storage Paths & Limits
DATA_DIR=data
UPLOADS_DIR=data/uploads
MAX_FILE_SIZE_MB=50
MAX_ROWS=500000
MAX_COLS=500
MAX_EXCEL_ROWS=100000
