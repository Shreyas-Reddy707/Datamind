# ==============================================================================
# DataMind v2 Environment Configuration Template
# Copy to .env in the repository root for local development (or run scripts/setup.ps1).
# NEVER commit .env to git.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:3000"]

# Database (Zero-Config Local Docker Postgres on Port 5432)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Redis Broker / Cache
REDIS_URL=redis://localhost:6379/0

# Security & Cryptography (Auto-generated by scripts/setup.ps1 or setup.sh)
# Manual generation: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_SECRET=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32

# LLM & Local Ollama Config (Optional — Built-in DuckDB engine works offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120

# Storage Paths & Safety Caps
DATA_DIR=data
UPLOADS_DIR=data/uploads
MAX_FILE_SIZE_MB=50
MAX_ROWS=500000
MAX_COLS=500
MAX_EXCEL_ROWS=100000
