meta {
  name: 01_register_login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "lead_analyst",
    "email": "analyst@datamind.local",
    "password": "CorrectHorseBatteryStaple99!",
    "org_name": "DataMind Analytics"
  }
}

assert {
  res.status: eq 201
  res.body.access_token: isDefined
  res.body.user.email: eq analyst@datamind.local
}

